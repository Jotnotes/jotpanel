# JotPanel backend environment. Copy to .env for local dev (gitignored).
# Required (server refuses to boot without these two):
JWT_SECRET=replace-with-a-long-random-secret   # openssl rand -hex 32
ADMIN_KEY=replace-with-a-random-admin-key       # openssl rand -hex 24
# Core:
NODE_ENV=development
PORT=9999
# The bootstrap surface: creating the first owner, a sign-in link for them,
# clearing a second factor, and the usage feed. Bound to 127.0.0.1 and never
# proxied, so it is administered on the machine rather than over the network.
# `off` switches the listener off entirely, which is safe once a box is
# installed and leaves those four with no way in at all.
JOTPANEL_BOOTSTRAP_PORT=9998
DOMAIN=localhost:5173
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_MB=25
# Optional (mail features): SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASS SMTP_FROM
# Echo platform AI keys — server-only, never shipped to the browser. Set the
# provider(s) the hosted product pays for; users without one fall back to BYOK.
# ANTHROPIC_API_KEY=  OPENAI_API_KEY=  GROQ_API_KEY=  GEMINI_API_KEY=  MISTRAL_API_KEY=
# OLLAMA_BASE=http://localhost:11434/v1/chat/completions   # local, no key
# Per-customer monthly AI spend cap in USD (platform default; overridable per user):
AI_MONTHLY_CAP_USD=10
# Demo tenant brain (?try=1). Unset = free local Resident. Set to frontier
# (with a platform key above) for demo-quality answers on your own key; the
# hard cap is re-pinned on every demo entry from JOTPANEL_DEMO_CAP_USD.
# JOTPANEL_CONCIERGE_BRAIN=frontier
# JOTPANEL_CONCIERGE_MODEL=claude-sonnet-5
# JOTPANEL_DEMO_CAP_USD=1
# Public origin for PhoneDrop QR links when behind a proxy (else derived from
# the requesting browser): JOTPANEL_PUBLIC_ORIGIN=https://demo.example.com
